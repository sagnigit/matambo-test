{
  "name": "matambo-test-prive",
  "productName": "Matambo Test",
  "version": "0.2.0",
  "description": "Partager le site Matambo en test privé : l'hôte l'expose via Cloudflare, les testeurs entrent avec une clé validée par l'hôte.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/passerelle.test.js test/testeur.test.js",
    "dist": "electron-builder --win nsis",
    "publier": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cm.matambo.testprive",
    "productName": "Matambo Test",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sagnigit",
        "repo": "matambo-test",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  }
}
